QMainWindow, QWidget#MainBg {
    background-color: #0D111A;
    color: #E2E8F0;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

QWidget {
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

QFrame#Sidebar {
    background-color: #111622;
    border-right: 1px solid #1E2638;
}

QFrame#Card, QFrame#MiniCard {
    background-color: #151B28;
    border: 1px solid #222B3E;
    border-radius: 10px;
}

QLabel#CardTitle {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
}

QLabel#SubLabel {
    color: #64748B;
    font-size: 11px;
}

QLabel#DashboardBrand {
    color: #22D3EE;
    font-size: 15px;
    font-weight: 700;
}

QLabel#DashboardFieldLabel {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 600;
}

QLabel#MetricTitle {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
}

QLabel#MetricValue {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 700;
}

QLabel#TopologySummary {
    color: #22D3EE;
    font-size: 12px;
    font-weight: 600;
    padding: 18px;
}

QLabel#StatusPill {
    background-color: #172334;
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 14px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#StatusPill[healthState="good"] {
    background-color: #12372F;
    color: #34D399;
    border-color: #10B981;
}

QLabel#StatusPill[healthState="warning"] {
    background-color: #3A2C12;
    color: #FBBF24;
    border-color: #F59E0B;
}

QLabel#StatusPill[healthState="error"] {
    background-color: #3B1720;
    color: #FB7185;
    border-color: #EF4444;
}

/* Капсула "СЕТЬ РАБОТАЕТ ОТЛИЧНО" */
QLabel#StatusPillGood {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34D399;
    border: 1px solid #10B981;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: bold;
}

/* Кнопка "+ Start Diagnostics" */
QPushButton#StartBtn {
    background-color: #06B6D4;
    color: #081018;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#StartBtn:hover {
    background-color: #22D3EE;
}

QPushButton#StartBtn:disabled {
    background-color: #155E75;
    color: #A5F3FC;
}

QPushButton#SecondaryActionBtn,
QPushButton#InlineActionBtn {
    background-color: #162338;
    color: #BAE6FD;
    border: 1px solid #1E7490;
    border-radius: 7px;
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#SecondaryActionBtn:hover,
QPushButton#InlineActionBtn:hover {
    background-color: #123B50;
    border-color: #22D3EE;
    color: #E0F2FE;
}

QLineEdit#DashboardInput,
QSpinBox#DashboardPort,
QComboBox#DashboardCombo {
    background-color: #101827;
    color: #E2E8F0;
    border: 1px solid #263147;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 22px;
}

QLineEdit#DashboardInput:focus,
QSpinBox#DashboardPort:focus,
QComboBox#DashboardCombo:focus {
    border-color: #06B6D4;
}

/* Кнопки меню слева */
QPushButton#NavBtn {
    background-color: transparent;
    color: #94A3B8;
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#NavBtn:hover {
    background-color: #1A2232;
    color: #FFFFFF;
}
QPushButton#NavBtn:checked {
    background-color: rgba(6, 182, 212, 0.15);
    color: #22D3EE;
    border: 1px solid rgba(6, 182, 212, 0.35);
    font-weight: bold;
}

/* Нижние кнопки экспорта в сайдбаре */
QPushButton#SideActionBtn {
    background-color: #161E2E;
    color: #CBD5E1;
    border: 1px solid #263147;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#SideActionBtn:hover {
    border-color: #06B6D4;
    color: #22D3EE;
}

QFrame#SidebarTools {
    background-color: #101827;
    border: 1px solid #263147;
    border-radius: 8px;
}

QFrame#SidebarTools QComboBox#LanguageSelector,
QFrame#SidebarTools QToolButton#ThemeToggle {
    background-color: #161E2E;
    color: #CBD5E1;
    border: 1px solid #263147;
    border-radius: 7px;
}

QFrame#SidebarTools QComboBox#LanguageSelector {
    min-height: 36px;
    max-height: 36px;
    padding: 0 26px 0 10px;
    font-size: 11px;
    font-weight: 700;
}

QFrame#SidebarTools QComboBox#LanguageSelector::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QFrame#SidebarTools QToolButton#ThemeToggle {
    min-height: 36px;
    max-height: 36px;
    padding: 0;
    font-size: 15px;
    qproperty-toolButtonStyle: ToolButtonTextOnly;
}

QFrame#SidebarTools QComboBox#LanguageSelector:hover,
QFrame#SidebarTools QComboBox#LanguageSelector:focus,
QFrame#SidebarTools QToolButton#ThemeToggle:hover {
    background-color: #1D2A3D;
    border-color: #22D3EE;
    color: #22D3EE;
}

QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    color: #E2E8F0;
    font-size: 12px;
}
QTableWidget::item {
    border-bottom: 1px solid #1E2638;
    padding: 6px;
}

QTableWidget#InterfacesTable {
    font-size: 14px;
}

QTableWidget#InterfacesTable QHeaderView::section {
    font-size: 13px;
    font-weight: 700;
    padding: 8px 6px;
}

QFrame#EventCard {
    min-height: 82px;
}

QPlainTextEdit#DashboardEventLog {
    background-color: transparent;
    border: none;
    color: #64748B;
    font-size: 11px;
}

QScrollArea#DashboardScroll {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: transparent;
    color: #64748B;
    border: none;
    border-bottom: 1px solid #1E2638;
    padding: 6px;
    font-size: 11px;
    font-weight: bold;
}
